<div class="header-section">
  <h1>💬 Chat en tiempo real</h1>
  <p style="text-align: center; color: var(--text-light);">Conversa con otros administradores conectados</p>
</div>

<div class="chat-container">
  <div id="chat-mensajes" class="chat-messages">
    <!-- Los mensajes se cargarán aquí -->
    <p style="text-align: center; color: var(--text-light); padding: 2rem;">Cargando mensajes...</p>
  </div>

  <div class="chat-input">
    <input type="text" id="mensajeInput" placeholder="Escribe un mensaje aquí..." autocomplete="off">
    <button id="enviarBtn">🚀 Enviar</button>
  </div>
</div>